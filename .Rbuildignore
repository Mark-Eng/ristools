^.*\.Rproj$
^\.Rproj\.user$
# GPL-3 is a standard R license, so DESCRIPTION's "License: GPL-3" is
# sufficient and the package need not ship the text. LICENSE.md is kept in the
# repository for GitHub's license display.
^LICENSE\.md$
^README\.Rmd$
^\.github$
^docs$
^_pkgdown\.yml$
^tests/ebsco_tests$
# Personal scratch scripts. R CMD check runs every tests/*.R file, so anything
# there that hits the network, needs a package outside Imports/Suggests, or
# writes outside the package would fail the check.
^tests/me_.*\.R$
